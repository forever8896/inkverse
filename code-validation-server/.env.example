# ink! Contract Checker Server Configuration
# Copy this file to .env and adjust values as needed

# Server
PORT=3000
NODE_ENV=development

# API Key
# Generate a secure key: openssl rand -hex 32
API_KEY=your-secret-api-key-here

# Redis (required for job queue)
REDIS_URL=redis://localhost:6379

# Worker Configuration
WORKER_CONCURRENCY=2

# Compilation
COMPILATION_TIMEOUT=120000  # 2 minutes in milliseconds
MAX_CODE_SIZE=102400        # 100KB
MAX_OUTPUT_SIZE=524288      # 512KB

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000  # 1 minute
RATE_LIMIT_MAX_REQUESTS=100 # General API limit
COMPILE_RATE_LIMIT_MAX=10   # Compilation requests per minute

# Paths (defaults are fine for Docker)
# CARGO_HOME=/app/compile_cache/cargo_home
# CARGO_TARGET_DIR=/app/compile_cache/target
# TEMP_DIR=/app/compile_cache/temp
