{
  "name": "contracts",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "node": "ink-node --dev --base-path ./.node-data",
    "build": "bash build.sh",
    "deploy": "node scripts/deploy.js",
    "deploy:pop": "CHAIN=pop node scripts/deploy.js",
    "deploy:shibuya": "CHAIN=shibuya node scripts/deploy.js",
    "codegen": "bash codegen.sh",
    "clean": "rm -rf target deployments/*/*.contract deployments/*/*.json deployments/*/*.polkavm"
  },
  "dependencies": {
    "@polkadot-api/descriptors": "file:.papi/descriptors",
    "@polkadot-api/sdk-ink": "0.5.1",
    "@polkadot/api": "^16.4.8",
    "@polkadot/api-contract": "^16.4.5",
    "dotenv": "^17.2.3"
  }
}
