{
  "name": "monsters-ink",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "lsof -ti:3004 | xargs kill -9 2>/dev/null || true",
    "dev": "PORT=3004 next dev --turbopack",
    "dev:workflow": "vercel dev --listen 3004 --yes",
    "prebuild": "echo 'Using pre-built descriptors'",
    "build": "next build",
    "prestart": "lsof -ti:3004 | xargs kill -9 2>/dev/null || true",
    "start": "PORT=3004 next start",
    "lint": "next lint",
    "test": "vitest",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "storage:start": "node scripts/setup-minio.js",
    "storage:setup": "node scripts/setup-minio.js",
    "db:migrate": "node scripts/migrate.js",
    "db:reset": "node scripts/reset-db.js",
    "db:setup": "npm run db:migrate",
    "workflow:web": "node scripts/workflow-web.js"
  },
