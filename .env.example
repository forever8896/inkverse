# Monster's Ink Environment Variables
# Copy this file to .env.local and fill in your values

# =============================================================================
# Application Configuration
# =============================================================================
# Application URL (used for auth callbacks and CORS)
# Development: http://localhost:3004
# Production: https://your-domain.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3004

# =============================================================================
# Database Configuration
# =============================================================================
# Create a local PostgreSQL database named 'monsters'
# Example: CREATE DATABASE monsters;
POSTGRES_URL="postgresql://your_username:your_password@localhost:5432/monsters"

# =============================================================================
# Authentication - Better Auth + GitHub OAuth
# =============================================================================
# GitHub OAuth Setup:
# 1. Create OAuth app at: https://github.com/settings/developers
# 2. Set callback URL to: http://localhost:3004/api/auth/callback/github
GITHUB_CLIENT_ID=your_github_client_id_here
GITHUB_CLIENT_SECRET=your_github_client_secret_here

# Better Auth Secret (generate with: openssl rand -hex 32)
BETTER_AUTH_SECRET=your_generated_secret_here

# =============================================================================
# AI Services (required for monster generation)
# =============================================================================
# OpenAI API Key - Get from: https://platform.openai.com/api-keys
OPENAI_PROJECT_ID=proj-your_project_id_here
OPENAI_API_KEY=sk-proj-your_openai_api_key_here

# fal.ai API Key - Get from: https://fal.ai/dashboard/keys
FAL_KEY=your_fal_api_key_here

# =============================================================================
# Storage Configuration - S3/MinIO
# =============================================================================
# For local development, use MinIO (run: npm run storage:start)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=monsters-dev
S3_REGION=us-east-1