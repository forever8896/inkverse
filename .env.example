# Monster's Ink Environment Variables
# Copy this file to .env.local and fill in your values

# =============================================================================
# Application Configuration
# =============================================================================
# Application URL (used for auth callbacks and CORS)
# Development: http://localhost:3004
# Production: https://your-domain.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3004

# =============================================================================
# Database Configuration
# =============================================================================
# Create a local PostgreSQL database named 'monsters'
# Example: CREATE DATABASE monsters;
POSTGRES_URL="postgresql://your_username:your_password@localhost:5432/monsters"

# =============================================================================
# Authentication - Better Auth + GitHub OAuth
# =============================================================================
# GitHub OAuth Setup:
# 1. Create OAuth app at: https://github.com/settings/developers
# 2. Set callback URL to: http://localhost:3004/api/auth/callback/github
GITHUB_CLIENT_ID=your_github_client_id_here
GITHUB_CLIENT_SECRET=your_github_client_secret_here

# Better Auth Secret (generate with: openssl rand -hex 32)
BETTER_AUTH_SECRET=your_generated_secret_here

# =============================================================================
# AI Services (required for monster generation)
# =============================================================================
# OpenAI API Key - Get from: https://platform.openai.com/api-keys
OPENAI_PROJECT_ID=proj-your_project_id_here
OPENAI_API_KEY=sk-proj-your_openai_api_key_here

# fal.ai API Key - Get from: https://fal.ai/dashboard/keys
FAL_KEY=your_fal_api_key_here

# =============================================================================
# Code Validation Server
# =============================================================================
# API key for the ink! code validation server (Bearer token auth)
# Default URL: https://monsters-code-validation-server-production.up.railway.app
# Optional: Override the URL with CODE_CHECKER_URL
CODE_CHECKER_API_KEY=your_code_checker_api_key_here
# CODE_CHECKER_URL=http://localhost:3000

# =============================================================================
# Storage Configuration - S3/MinIO
# =============================================================================
# For local development, use MinIO (run: npm run storage:start)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=monsters-dev
S3_REGION=us-east-1

# =============================================================================
# Polkadot Asset Hub - NFT Minting
# =============================================================================
# Platform wallet - run: npx ts-node scripts/generate-platform-account.ts
PLATFORM_ACCOUNT_SEED="your twelve word seed phrase here"
NEXT_PUBLIC_PLATFORM_ADDRESS="your_ss58_address_here"

# NFT collection - run: npx ts-node scripts/create-collection-paseo.ts
NFTS_COLLECTION_ID=0
NEXT_PUBLIC_NFTS_COLLECTION_ID=0

# Asset Hub RPC (Paseo testnet or Polkadot mainnet)
ASSET_HUB_RPC_URL=wss://passet-hub-paseo.ibp.network

# =============================================================================
# Pinata IPFS - NFT Metadata Storage
# =============================================================================
# Get credentials at: https://app.pinata.cloud/developers/api-keys
# Verify config: npx ts-node scripts/verify-pinata-config.ts
PINATA_API_KEY=your_pinata_api_key
PINATA_API_SECRET=your_pinata_api_secret
PINATA_JWT=your_pinata_jwt_token
PINATA_GATEWAY=your-gateway.mypinata.cloud
PINATA_GATEWAY_KEY=your_gateway_key

# =============================================================================
# GitHub App for Lesson Editor PR Submission (admin only)
# =============================================================================
# Create a GitHub App at: https://github.com/settings/apps/new
# Permissions: Repository contents (read & write), Pull requests (read & write)
# Install on forever8896/inkverse, then set these values:
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_INSTALLATION_ID=